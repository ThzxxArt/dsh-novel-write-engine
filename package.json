{
  "name": "dsh-novel-write-engine",
  "version": "0.2.0",
  "description": "Novel writing engine for DeepSeek Harness: state machine, gates, rulepacks and ledgers moved from prompts into code.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "writing"
  ],
  "homepage": "https://github.com/ThzxxArt/dsh-novel-write-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThzxxArt/dsh-novel-write-engine.git"
  },
  "bugs": {
    "url": "https://github.com/ThzxxArt/dsh-novel-write-engine/issues"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.9",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./rulepacks/*": "./rulepacks/*",
    "./briefs/*": "./briefs/*",
    "./skill": "./skills/entry.md",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "rulepacks",
    "briefs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/novel-write-engine.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:isolated": "node scripts/check-isolated.mjs",
    "validate:rulepack": "node scripts/validate-rulepack.mjs",
    "check:preset": "node scripts/check-preset.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:host": "node scripts/check-host.mjs",
    "check:crash": "node scripts/check-crash.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.15.0",
    "happy-dom": "^15.11.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}
